<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Contrast Checker"
           Manufacturer="Scott Vinkle"
           Version="1.0.0.0"
           UpgradeCode="d1e2f3a4-b5c6-7890-1234-567890abcdef"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\ContrastChecker\Resources\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/svinkle/contrast-checker" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ContrastChecker">
        <Component Id="MainExecutable" Guid="a1b2c3d4-1111-2222-3333-444455556666">
          <File Id="ContrastCheckerExe"
                Source="$(var.PublishDir)\ContrastChecker.exe"
                KeyPath="yes" />
        </Component>

        <Component Id="AppIconFile" Guid="a1b2c3d4-1111-2222-3333-777788889999">
          <File Id="AppIco"
                Source="..\ContrastChecker\Resources\app.ico"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu Shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent" Guid="b2c3d4e5-2222-3333-4444-555566667777">
        <Shortcut Id="StartMenuShortcut"
                  Name="Contrast Checker"
                  Description="A native utility for measuring color contrast anywhere across the operating system."
                  Target="[!ContrastCheckerExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\ScottVinkle\ContrastChecker"
                       Name="StartMenuShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="c3d4e5f6-3333-4444-5555-666677778888">
        <Shortcut Id="DesktopShortcut"
                  Name="Contrast Checker"
                  Description="A native utility for measuring color contrast anywhere across the operating system."
                  Target="[!ContrastCheckerExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\ScottVinkle\ContrastChecker"
                       Name="DesktopShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Contrast Checker" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppIconFile" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>

